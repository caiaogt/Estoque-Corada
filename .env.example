# Connection string do banco Postgres (Supabase > Project Settings > Database > Connection string > URI)
DATABASE_URL=

# Credenciais do aplicativo Bling (developer.bling.com.br > Área do Integrador)
# Copie este arquivo para ".env" e preencha com os valores reais.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Precisa ser EXATAMENTE a mesma URL cadastrada como "Link de redirecionamento" no app do Bling
BLING_REDIRECT_URI=http://localhost:3000/api/bling/callback
